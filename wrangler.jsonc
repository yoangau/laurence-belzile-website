{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laurence-belzile",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Static pages are served by the assets layer; only /api, /admin, /media and /projects reach the Worker.
  "assets": { "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Staging on the owner's other domain. At cutover, add laurencebelzile.com and www.laurencebelzile.com
  // (see docs/setup-cloudflare.md); the staging domain can stay or be removed.
  "routes": [{ "pattern": "lb.inscape.xyz", "custom_domain": true }],
  "workers_dev": false,
  // Public media (images, PDFs). Served from https://media.laurencebelzile.com (R2 custom domain).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "lb-media" },
    // Private: draft.json, published.json, history/, originals/.
    { "binding": "CONTENT", "bucket_name": "lb-content" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "lb", "database_id": "33cdd599-45bd-466f-be72-982219b11cfa", "migrations_dir": "migrations" }
  ],
  // Non-secret settings. Secrets (GITHUB_TOKEN, ADMIN_EMAILS) are set with `wrangler secret put`.
  "vars": {
    "GITHUB_REPO": "yoangau/laurence-belzile-website",
    // Branch whose deploy workflow "Publier" runs. Use the v2 branch while testing, `master` after cutover.
    "DEPLOY_BRANCH": "master",
    // Cloudflare Access (Zero Trust) application protecting /admin and /api/admin.
    "CF_ACCESS_TEAM_DOMAIN": "laurencebelzile.cloudflareaccess.com",
    "CF_ACCESS_AUD": "aab0bd6ee66ec8219caa1a9de86e8ecf529560d81d5b3662be946e5ecf39b05f"
  }
}
