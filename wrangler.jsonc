{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laurence-belzile",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Public media (images, PDFs). Served from https://media.laurencebelzile.com (R2 custom domain).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "lb-media" },
    // Private: draft.json, published.json, history/, originals/.
    { "binding": "CONTENT", "bucket_name": "lb-content" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "lb", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  // Non-secret settings. Secrets (GITHUB_TOKEN, CF_ACCESS_AUD) are set with `wrangler secret put`.
  "vars": {
    "GITHUB_REPO": "yoangau/laurence-belzile-website",
    // Branch whose deploy workflow "Publier" runs. Use the v2 branch while testing, `master` after cutover.
    "DEPLOY_BRANCH": "master",
    "ADMIN_EMAILS": "laurence.belzile.arts@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "REPLACE_ME.cloudflareaccess.com"
  }
}
