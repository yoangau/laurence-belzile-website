---
/**
 * Everything search engines and social networks read. Rendered into static HTML at build time,
 * so link previews (Facebook, iMessage, Slack…) work without JavaScript.
 */
import type { Locale } from '../content/schema';
import { alternatePath, HTML_LANG } from '../i18n/ui';

export type SeoImage = { url: string; width?: number; height?: number; alt: string };

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: SeoImage | undefined;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | undefined;
  noindex?: boolean;
}

const { locale, title, description, image, type = 'website', jsonLd, noindex = false } = Astro.props;
const site = Astro.site!.origin;
const canonical = `${site}${Astro.url.pathname === '/' ? '' : Astro.url.pathname.replace(/\.html$/, '')}` || site;
const urlFor = (to: Locale) => {
  const path = alternatePath(Astro.url.pathname.replace(/\.html$/, ''), to);
  return path === '/' ? site : `${site}${path}`;
};
const ogLocale = (l: Locale) => HTML_LANG[l].replace('-', '_');
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Laurence Belzile" />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="fr-CA" href={urlFor('fr')} />
<link rel="alternate" hreflang="en-CA" href={urlFor('en')} />
<link rel="alternate" hreflang="x-default" href={urlFor('fr')} />

<meta property="og:site_name" content="Laurence Belzile" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale(locale)} />
<meta property="og:locale:alternate" content={ogLocale(locale === 'fr' ? 'en' : 'fr')} />
{image && (
  <>
    <meta property="og:image" content={image.url} />
    <meta property="og:image:alt" content={image.alt} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}
  </>
)}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image.url} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
