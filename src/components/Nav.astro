---
import type { Locale } from '../content/schema';
import { pick, docUrl } from '../content/format';
import { alternatePath, localePath, useTranslations } from '../i18n/ui';
import { content, documentsFor, MEDIA_URL } from '../site/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const other: Locale = locale === 'fr' ? 'en' : 'fr';
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/^\/en(?=\/|$)/, '') || '/';

const links = [
  { href: '/work', label: t('nav.work') },
  ...documentsFor('nav').map((doc) => ({ href: docUrl(MEDIA_URL, doc.file[locale]), label: pick(doc.label, locale), external: true })),
  { href: '/exhibitions', label: t('nav.exhibitions') },
  { href: '/cv', label: t('nav.cv') },
  { href: '/info', label: t('nav.info') },
  { href: '/contact', label: t('nav.contact') },
];
const { instagramUrl } = content.settings;
---

<nav class="nav" aria-label="Menu">
  <ul>
    {
      links.map((link) => (
        <li>
          <a
            href={'external' in link ? link.href : localePath(locale, link.href)}
            aria-current={current === link.href ? 'page' : undefined}
            data-astro-prefetch={'external' in link ? undefined : ''}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    {
      instagramUrl && (
        <li>
          <a href={instagramUrl} target="_blank" rel="noopener" aria-label="Instagram" class="icon">
            <svg viewBox="0 0 24 24" width="14pt" height="14pt" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4 1.2-.1 1.6-.1 4.8-.1M12 0C8.7 0 8.3 0 7.1.1 5.8.1 4.9.3 4.1.6c-.8.3-1.5.7-2.1 1.4C1.3 2.6.9 3.3.6 4.1.3 4.9.1 5.8.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.3 2.2.6 2.9.3.8.7 1.5 1.4 2.1.6.7 1.3 1.1 2.1 1.4.8.3 1.6.5 2.9.6 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c1.3-.1 2.2-.3 2.9-.6.8-.3 1.5-.7 2.1-1.4.7-.6 1.1-1.3 1.4-2.1.3-.8.5-1.6.6-2.9.1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.1-1.3-.3-2.2-.6-2.9-.3-.8-.7-1.5-1.4-2.1-.6-.7-1.3-1.1-2.1-1.4-.8-.3-1.6-.5-2.9-.6C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z"
              />
            </svg>
          </a>
        </li>
      )
    }
    <li>
      <a href={alternatePath(Astro.url.pathname.replace(/\.html$/, ''), other)} hreflang={other} lang={other} class="lang">
        <span class="visually-hidden">{t('nav.switchLabel')}</span><b aria-hidden="true">{t('nav.switch')}</b>
      </a>
    </li>
  </ul>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 0.5rem 1rem;
    text-align: right;
    background: transparent;
  }
  ul {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    margin: 0 0.5em;
    color: var(--ink);
    font-size: 15pt;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--muted);
  }
  .icon {
    display: flex;
  }
</style>
