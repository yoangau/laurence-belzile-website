---
/** One work in a feed: its main image at its curated display width, linking to its page. */
import type { Locale, Work } from '../content/schema';
import { titlePlain } from '../content/format';
import { localePath } from '../i18n/ui';
import Picture from './Picture.astro';

interface Props {
  work: Work;
  locale: Locale;
  /** Ids to put on this item, so `#2024` / `#available-2024` scroll to it. */
  anchors?: string[];
  eager?: boolean;
}

const { work, locale, anchors = [], eager = false } = Astro.props;
const available = work.kind === 'artwork' && work.availability === 'available';
const width = `${work.displayWidth}%`;
---

<div class="item" data-available={String(available)}>
  {anchors.map((id) => (
    <span id={id} class="anchor" />
  ))}
  <a href={localePath(locale, `/projet/${work.id}`)} class="link reveal" style={`width:${width}`} data-astro-prefetch>
    <Picture
      image={work.images[0]!}
      alt={titlePlain(work, locale)}
      sizes={`(max-width: 768px) calc(70vw * ${work.displayWidth / 100}), calc(80vw * ${work.displayWidth / 100})`}
      eager={eager}
    />
  </a>
</div>

<style>
  .item {
    position: relative;
    width: var(--column);
    margin: 4em 0 8em;
  }
  .anchor {
    position: absolute;
    top: -4em;
  }
  .link {
    display: block;
  }
  .link :global(img) {
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .link:hover :global(img),
  .link:focus-visible :global(img) {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    transform: scale(1.03);
  }
  :global([data-filter='available']) .item[data-available='false'] {
    display: none;
  }
  @media (max-width: 768px) {
    .item {
      margin: 2em 0 4em;
    }
  }
</style>
