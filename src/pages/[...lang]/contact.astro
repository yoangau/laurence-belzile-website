---
import Base from '../../layouts/Base.astro';
import { localeFromParam, localeParams, useTranslations } from '../../i18n/ui';
import { content } from '../../site/content';

export const getStaticPaths = localeParams;

const locale = localeFromParam(Astro.params.lang);
const t = useTranslations(locale);
const { email, instagramUrl, facebookUrl } = content.settings;
---

<Base locale={locale} title={t('contact.title')}>
  <div class="reveal">
    <h1>{t('contact.title')}</h1>
    <p class="mail"><a href={`mailto:${email}`}>{email}</a></p>

    <h2>{t('contact.mailingList')}</h2>
    <form class="subscribe" method="post" action="/api/subscribe" data-subscribe>
      <input type="hidden" name="locale" value={locale} />
      <label class="visually-hidden" for="email">{t('contact.email')}</label>
      <input id="email" type="email" name="email" required autocomplete="email" placeholder={t('contact.email')} />
      <button type="submit" data-idle={t('contact.subscribe')} data-busy={t('contact.subscribing')}>{t('contact.subscribe')}</button>
      <p class="status" role="status" aria-live="polite" data-ok={t('contact.subscribed')} data-error={t('contact.failed')}></p>
    </form>

    <ul class="social">
      {
        facebookUrl && (
          <li>
            <a href={facebookUrl} target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"
                />
              </svg>
            </a>
          </li>
        )
      }
      {
        instagramUrl && (
          <li>
            <a href={instagramUrl} target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4 1.2-.1 1.6-.1 4.8-.1M12 0C8.7 0 8.3 0 7.1.1 5.8.1 4.9.3 4.1.6c-.8.3-1.5.7-2.1 1.4C1.3 2.6.9 3.3.6 4.1.3 4.9.1 5.8.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.3 2.2.6 2.9.3.8.7 1.5 1.4 2.1.6.7 1.3 1.1 2.1 1.4.8.3 1.6.5 2.9.6 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c1.3-.1 2.2-.3 2.9-.6.8-.3 1.5-.7 2.1-1.4.7-.6 1.1-1.3 1.4-2.1.3-.8.5-1.6.6-2.9.1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.1-1.3-.3-2.2-.6-2.9-.3-.8-.7-1.5-1.4-2.1-.6-.7-1.3-1.1-2.1-1.4-.8-.3-1.6-.5-2.9-.6C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z"
                />
              </svg>
            </a>
          </li>
        )
      }
    </ul>
  </div>

  <script>
    import '../../scripts/subscribe';
  </script>
</Base>

<style>
  h1,
  h2 {
    font-size: 3vh;
    font-weight: 1000;
  }
  .mail {
    margin-bottom: 8vh;
  }
  .mail a {
    color: var(--ink);
    font-size: 3vh;
  }
  .mail a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .subscribe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em;
    align-items: center;
  }
  input[type='email'] {
    padding: 5px 12px;
    border: 1px solid #e1e4e8;
    border-radius: 6px;
    color: #24292e;
    font-size: max(16px, 2vh);
    line-height: 20px;
  }
  button {
    padding: 5px 16px;
    border: 1px solid #1b1f2326;
    border-radius: 6px;
    background: #fafbfc;
    color: #24292e;
    font-size: max(16px, 2vh);
    font-weight: 500;
    cursor: pointer;
  }
  button:hover {
    background: #f3f4f6;
  }
  button:disabled {
    cursor: progress;
    opacity: 0.7;
  }
  .status {
    flex-basis: 100%;
    margin: 0.5em 0 0;
    font-size: 3vh;
    color: var(--ink);
  }
  .social {
    display: flex;
    gap: 1em;
    margin: 8vh 0 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: block;
    width: 3vh;
    height: 3vh;
    color: var(--ink);
  }
  .social a:hover {
    color: var(--muted);
  }
  .social svg {
    width: 100%;
    height: 100%;
  }
</style>
