---
import Base from '../../layouts/Base.astro';
import Feed from '../../components/Feed.astro';
import { ogImageUrl, titlePlain } from '../../content/format';
import { localeFromParam, localeParams, useTranslations } from '../../i18n/ui';
import { absoluteUrl, exhibitions, MEDIA_URL } from '../../site/content';

export const getStaticPaths = localeParams;

const locale = localeFromParam(Astro.params.lang);
const t = useTranslations(locale);
// Newest year first; within a year, in the order they were added (as on the v1 site).
const sorted = [...exhibitions].reverse().sort((a, b) => b.year - a.year);
const first = sorted[0];
---

<Base
  locale={locale}
  title={t('exhibitions.title')}
  image={
    first && { url: absoluteUrl(ogImageUrl(MEDIA_URL, first.images[0]!), Astro.site!), alt: titlePlain(first, locale) }
  }
>
  <h1 class="visually-hidden">{t('exhibitions.title')}</h1>
  <Feed works={sorted} locale={locale} variant="exhibition" />
</Base>
