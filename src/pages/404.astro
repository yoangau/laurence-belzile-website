---
import Base from '../layouts/Base.astro';
import { localePath, useTranslations } from '../i18n/ui';

const locale = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const t = useTranslations(locale);
---

<Base locale={locale} title={t('notFound.title')} noindex>
  <h1>{t('notFound.title')}</h1>
  <p><a href={localePath(locale, '/')}>{t('notFound.back')}</a></p>
</Base>
