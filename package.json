{
  "name": "laurence-belzile-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "postinstall": "wrangler types --include-runtime=true > /dev/null",
    "migrate": "tsx scripts/migrate/index.ts",
    "content:pull": "mkdir -p .content && wrangler r2 object get lb-content${CLOUDFLARE_ENV:+-$CLOUDFLARE_ENV}/published.json --remote --file .content/published.json",
    "content:pull:local": "mkdir -p .content && wrangler r2 object get lb-content/published.json --local --file .content/published.json",
    "db:migrate:local": "wrangler d1 migrations apply lb --local",
    "subscribers:import": "tsx scripts/import-subscribers.ts",
    "deploy": "npm run content:pull && astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/react": "^7.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/rokkitt": "^5.3.0",
    "@jsquash/webp": "^1.5.0",
    "@mantine/core": "^9.8.0",
    "@mantine/dropzone": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
    "astro": "^7.4.11",
    "immer": "^11.2.10",
    "jose": "^6.2.17",
    "photoswipe": "^5.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws4fetch": "^1.0.20",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=22"
  }
}
